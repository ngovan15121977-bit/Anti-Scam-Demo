{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timi.local/schemas/manager_recommendation.json",
  "title": "BankRiskManagerOutput",
  "description": "Phase 2 v0.1 — output of Bank Risk Manager Agent. LLM recommendation only; backend validates before action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommended_action",
    "confidence",
    "rationale",
    "evidence_used",
    "missing_info",
    "escalate_to_human"
  ],
  "properties": {
    "recommended_action": {
      "type": "string",
      "enum": ["CONTINUE", "MONITOR", "PAUSE", "STOP"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "evidence_used": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "maxItems": 12
    },
    "missing_info": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "maxItems": 8
    },
    "escalate_to_human": {
      "type": "boolean"
    }
  }
}
